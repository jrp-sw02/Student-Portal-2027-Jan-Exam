    protected List<String> GenerateRollNumber(int ExamId, int RegionalCentreId, int TotalCand)
    {
        //-----Total Length is 12 of a Roll Number------------
        List<String> RollNumbers = new List<string>();
        var context = new EConnectContext();
        String ExamYear = "", ExamMonth = "", CourseCode = "", RollNumber = "", serial = "";
        var Exam = context.Exams.Find(ExamId);
        var RcCode = context.RegionalCenters.Find(RegionalCentreId).Code;

        ExamYear = Exam.ExamYear.ToString().Substring(2, 2);
        ExamMonth = Exam.ExamMonth.ToString();
        if (ExamMonth.Length == 1)
        { ExamMonth = "0" + ExamMonth; }
        CourseCode = Exam.Course.Code;

        if (CourseCode == "CCC")
            RollNumber = RcCode + ExamYear + ExamMonth;
        else if (CourseCode == "BCC")
            RollNumber = RcCode + "B" + ExamYear + ExamMonth;
        else if (CourseCode == "CCCP")
            RollNumber = RcCode + "C" + ExamYear + ExamMonth;
        else if (CourseCode == "ECC")
            RollNumber = RcCode + "EC" + ExamYear + ExamMonth;
        else if (CourseCode == "POS-EXAM")
            RollNumber = RcCode + "I" + ExamYear + ExamMonth;
        else
        { }
        String TempRollNumber = RollNumber;
        for (int Number = 1; Number <= TotalCand; Number++)
        {

            if (CourseCode == "CCC")
                serial = Number.ToString("D6");
            else if (CourseCode == "BCC")
                serial = Number.ToString("D5");
            else if (CourseCode == "CCCP")
                serial = Number.ToString("D5");
            else if (CourseCode == "ECC")
                serial = Number.ToString("D4");
            else if (CourseCode == "POS-EXAM")
                serial = Number.ToString("D5");
            else { }
            RollNumber = TempRollNumber + serial;
            RollNumbers.Add(RollNumber);
        }
        return RollNumbers;
    }

    protected static List<Allocation> GetSeatList(int ExamId, int RCid, int TotalCand, Dictionary<int, string> BatchList)
    {
        var context = new EConnectContext();
        List<Allocation> AllocationList = new List<Allocation>();
        #region comment
        //var CentreList = context.ExamCentreAvailableStats.Join(context.ExamCentreExamDates, p => p.CentreCode, q => q.CentreCode, (p, q) => new{p, q}). 
        //                         Where(s => s.ExamId == ExamId && s.RegionalCentreId == RCid).
        //                         Select(p => new
        //                         {
        //                             CityCode = p.CityCode,
        //                             CentreCode = p.CentreCode,
        //                             BatchSize = p.CentreBatchSize,
        //                             BufferSize = p.CentreBatchBufferSize,
        //                             CCCId = (p.CentreCCCId != 0) ? p.CentreCCCId : 0,
        //                             CentreAddress = p.CentreAddress
        //                         }); 
        #endregion
        var CentreList = from p in context.ExamCentreAvailableStats
                         join q in context.ExamCentreExamDates on p.CentreCode equals q.CentreCode
                         where p.ExamId == ExamId && p.RegionalCentreId == RCid && q.ExamId == ExamId && q.RegionalCentreId == RCid
                         select new
                         {
                             CityCode = p.CityCode,
                             CentreCode = p.CentreCode,
                             BatchSize = p.CentreBatchSize,
                             BufferSize = p.CentreBatchBufferSize,
                             CCCId = (p.CentreCCCId != 0) ? p.CentreCCCId : 0,
                             CentreAddress = p.CentreAddress,
                             ExamDate = q.ExamDate
                         };
        CentreList = CentreList.OrderBy(s => s.ExamDate);

        int TicketNumber = 0;
        foreach (var item in CentreList)
        {

            //for (int i = 0; i < ExamDates.Count; i++)
            //{
            for (int j = 0; j < BatchList.Count; j++)
            {
                int BatchId = BatchList.Keys.ElementAt(j);
                String RepTime = BatchList[BatchId];
                for (int k = 0; k < item.BatchSize; k++)
                {
                    Allocation aloc = new Allocation();

                    aloc.TicketNo = ++TicketNumber;
                    aloc.AppId = 0;
                    aloc.RollNumber = "";

                    aloc.CCCId = item.CCCId;
                    aloc.CityCode = item.CityCode;
                    aloc.CentreCode = item.CentreCode;
                    aloc.CentreAddress = item.CentreAddress;

                    aloc.ExamDate = item.ExamDate;
                    aloc.BatchId = BatchId;
                    aloc.RepTime = RepTime;
                    aloc.IsAllocated = false;
                    AllocationList.Add(aloc);
                }

            }
            //}
        }

        return AllocationList;
    }

