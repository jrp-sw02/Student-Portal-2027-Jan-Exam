                Response.Redirect("ExamCentreUpload.aspx?CourseID=" + Request.QueryString["CourseID"] + "&ExamID=" + Request.QueryString["ExamID"] + "&ExamCycleID=" + Request.QueryString["ExamCycleID"] + "&ExamYear=" + Request.QueryString["ExamYear"] + "&RegCentreID=" + Request.QueryString["RegCentreID"], true);
            }
            else
            {
                Response.Redirect("ExamCentreUpload.aspx", true);
            }
        }
    }
