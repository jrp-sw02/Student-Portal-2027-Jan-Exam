    protected void btnUpload_Click(object sender, EventArgs e)
    {
        Int32 CourseCategoryID = Convert.ToInt32(ddlCourseCategry.SelectedValue);
        Int32 CourseID = Convert.ToInt32(ddlCourseName.SelectedValue);
        Int32 ExamCycleID = Convert.ToInt32(ddlExamCycle.SelectedValue);
        Int32 ExamID = Convert.ToInt32(ddlExamName.SelectedValue);
        Int32 regCentreID = Convert.ToInt32(ddlRegionalCentre.SelectedValue);
        //--------Check Already uploaded-------------------------
        try
        {
            using (var context = new EConnectContext())
            {
                var uploadeddata = (from p in context.ExamCentreAvailableStats
                                   where p.ExamId == ExamID && p.RegionalCentreId == regCentreID
                                   select p).Count();
                if (uploadeddata > 0)
                {
                    throw new Exception("Data has been already uploaded");
                }
            }
        }
        catch (Exception ex) { ShowAlert(ex.Message); }
        //--------------------------------------------------------

        StringBuilder sb = new StringBuilder();

        string filepath = Server.MapPath("../UploadedFiles");
        flUpload.SaveAs(filepath + "/" + flUpload.FileName);
        string path = (filepath + "/" + flUpload.FileName);
        string ext = System.IO.Path.GetExtension(this.flUpload.PostedFile.FileName);
        string accessConnectionString = "";
        if (ext.ToUpper() == ".MDB")
        { //accessConnectionString = string.Format("Provider=Microsoft.Jet.OLEDB.4.0;Data Source={0};Persist Security Info=False;", path);
            accessConnectionString = string.Format("Provider=Microsoft.ACE.OLEDB.12.0;Data Source={0};Persist Security Info=False;", path);
        }
        else if (ext.ToUpper() == ".ACCDB")
        {
            //accessConnectionString = string.Format("Provider=Microsoft.Jet.OLEDB.4.0;Data Source={0};Persist Security Info=False;", path);
            accessConnectionString = string.Format("Provider=Microsoft.ACE.OLEDB.12.0;Data Source={0};Persist Security Info=False;", path);
        }
        else
        {
            ShowAlert("Please Choose .MDB/.ACCDB Extension Database", true);
            return;
        }

        OleDbConnection connection = new OleDbConnection();
        connection.ConnectionString = accessConnectionString;
        connection.Open();
        //[MS Access;Database=" + Access + "].[Exam_Database]", connection);
        OleDbCommand command = new OleDbCommand("select * from [MS Access;Database=" + path + "].[Exam_Centre]", connection);
        OleDbDataReader dr = command.ExecuteReader();
       
        OleDbCommand command1 = new OleDbCommand("select * from [MS Access;Database=" + path + "].[Exam_Centre_Dates]", connection);
        OleDbDataReader dr1 = command1.ExecuteReader();
        int TotalRecords = 0;

        EConnect.Connections.SqlCon con = new EConnect.Connections.SqlCon();
        try
        {
            var context = new EConnectContext();
            if (!CheckDuplicateCentre(path, ext))
            {
               
                while (dr.Read())
                {

                    TotalRecords = TotalRecords + 1;
                    if (!String.IsNullOrEmpty(dr["City_Code"].ToString()) && !String.IsNullOrEmpty(dr["Centre_Code"].ToString()) && !String.IsNullOrEmpty(dr["Centre_Address"].ToString()) && !String.IsNullOrEmpty(dr["Batch_Size"].ToString()) && !String.IsNullOrEmpty(dr["Batch_BufferSize"].ToString()) && !String.IsNullOrEmpty(dr["Regional_Centre"].ToString()))
                    {
                        ExamCentreAvailableStat objnew = new ExamCentreAvailableStat();

                        objnew.ExamId = ExamID;
                        objnew.RegionalCentreId = regCentreID;
                        objnew.CityCode = dr["City_Code"].ToString();
                        objnew.CentreCode = dr["Centre_Code"].ToString();
                        objnew.CentreCCCId = Convert.ToInt64(dr["CCC_No"]);
                        objnew.CentreBatchSize = Convert.ToInt16(dr["Batch_Size"]);
                        objnew.CentreBatchBufferSize = Convert.ToInt16(dr["Batch_BufferSize"]);
                        objnew.CentreAddress = dr["Centre_Address"].ToString();
                        objnew.CentreContactPerson = dr["Centre_Contact_Person"].ToString();
                        objnew.CentreContactEmail = dr["Centre_Contact_Email"].ToString();
                        objnew.CentreContactMobile = Convert.ToInt64(dr["Centre_Contact_Mobile"]);
                        objnew.CreatedByID = entityID;
                        objnew.CreatedOn = DateTime.Now;

                        context.ExamCentreAvailableStats.Add(objnew);
                        context.SaveChanges();
                    }
                }
                lblTotalRecords.Text = TotalRecords.ToString();

                while (dr1.Read())
                {
                    ExamCentreExamDate objdate = new ExamCentreExamDate();
                    objdate.ExamId = ExamID;
                    objdate.RegionalCentreId = regCentreID;
                    //objdate.CityCode = dr["City_Code"].ToString();
                    objdate.CentreCode = dr1["Centre_Code"].ToString();
                    objdate.ExamDate = Convert.ToDateTime(dr1["Exam_Date"]);
                    objdate.CreatedByID = entityID;
                    objdate.CreatedOn = DateTime.Now;

                    context.ExamCentreExamDates.Add(objdate);
                    context.SaveChanges();
                }

            }
            //else { throw new Exception("Invalid / Duplicate City_Code or Centre_Code are not allowed"); }

        }

        catch (Exception ex)
        {
            ShowAlert(ex.Message, true);
        }
        finally
        {
            sb.Clear();
            dr.Close();
            dr.Dispose();
            command.Dispose();
            connection.Close();
            con.Close();
            connection.Dispose();
            System.IO.File.Delete(path);
            dr1.Close();
            dr1.Dispose();
            command1.Dispose();
        }

    }
    protected bool CheckDuplicateCentre(string path, string ext)
    {
        StringBuilder ErrorMsg = new StringBuilder();
        InvalidCity.Text = "";
        Int32 CourseCategoryID = Convert.ToInt32(ddlCourseCategry.SelectedValue);
        Int32 CourseID = Convert.ToInt32(ddlCourseName.SelectedValue);
        Int32 ExamCycleID = Convert.ToInt32(ddlExamCycle.SelectedValue);
        Int32 ExamID = Convert.ToInt32(ddlExamName.SelectedValue);
        Int32 regCentreID = Convert.ToInt32(ddlRegionalCentre.SelectedValue);

        //------------------------------------------------------------------------
        using (var context = new EConnectContext())
        {
            int CentreList = context.ExamCentreAvailableStats.Where(s => s.ExamId == ExamID && s.RegionalCentreId == regCentreID).Count();
            if (CentreList > 0)
            {
                ErrorMsg.Append("Centre List For the <br/>Regional Centre: <b>" + ddlRegionalCentre.SelectedItem.Text + "</b> <br/> Courese Name: <b>" + ddlCourseName.SelectedItem.Text + "</b> <br/> Exam Name: <b>" + ddlExamName.SelectedItem.Text + "</b> is already uploaded.");
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
        }
        //------------------------------------------------------------------------


        string accessConnectionString = "";
        if (ext.ToUpper() == ".MDB")
        { //accessConnectionString = string.Format("Provider=Microsoft.Jet.OLEDB.4.0;Data Source={0};Persist Security Info=False;", path);
            accessConnectionString = string.Format("Provider=Microsoft.ACE.OLEDB.12.0;Data Source={0};Persist Security Info=False;", path);
        }
        else if (ext.ToUpper() == ".ACCDB")
            accessConnectionString = string.Format("Provider=Microsoft.ACE.OLEDB.12.0;Data Source={0};Persist Security Info=False;", path);
        OleDbConnection connection = new OleDbConnection();
        connection.ConnectionString = accessConnectionString;
        connection.Open();
        EConnect.Connections.SqlCon con = new EConnect.Connections.SqlCon();

        try
        {
            //[MS Access;Database=" + Access + "].[Exam_Centre]", connection);
            OleDbCommand command = new OleDbCommand("select City_Code, Centre_Code, Batch_Size, Batch_BufferSize, Centre_Address, Centre_Contact_Person, Centre_Contact_Email, Centre_Contact_Mobile from [MS Access;Database=" + path + "].[Exam_Centre]", connection);
            OleDbDataAdapter dtadpt = new OleDbDataAdapter(command);
            DataTable UploadDataSheet = new DataTable();
            dtadpt.Fill(UploadDataSheet);
            //---------------Check 0-----Blank FIle----------------------------
            if (UploadDataSheet.Rows.Count == 0)
            {
                ErrorMsg.Append("<b>Uploaded file has Zero records. Please see the Uploaded data!</b>");
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
            //---------------------------------------------------------------------
            //------------------Check 1 ---Check Null int the table----------------
            foreach (DataColumn column in UploadDataSheet.Columns)
            {
                if (UploadDataSheet.Rows.OfType<DataRow>().Any(r => r.IsNull(column)))
                {
                    ErrorMsg.Append("<b>Uploaded files cannot have null or empty</b></br>  ");
                    InvalidCity.Text = ErrorMsg.ToString();
                    return true;
                }
            }
            //-----------------------------------------------------------------------
            //------------------CHECK 2---CentreCode pattern with respect to CityCode------Valid Pattern <CityCode + Number>------
            var InvalidCentrePattern = from tbl in UploadDataSheet.AsEnumerable()
                                       let CityCode = tbl.Field<string>("City_Code")
                                       let CentreCode = tbl.Field<string>("Centre_Code")
                                       where !Regex.IsMatch(CentreCode, CityCode + @"(\d+)")
                                       select new { CityCode, CentreCode };

            if (InvalidCentrePattern.Count() > 0)
            {

                ErrorMsg.Append("<b>InValid CentreCode Pattern:</b></br>  ");
                foreach (var InvalidCentre in InvalidCentrePattern)
                {
                    ErrorMsg.Append(InvalidCentre.CentreCode + ", ");
                }
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
            //-----------------------------------------------------------------------------
            //------------------CHECK 3-----------------------------------------------
            IEnumerable<string> DuplicateCentre = UploadDataSheet.AsEnumerable().GroupBy(r => r["Centre_Code"], (key, g) => new { CentreCode = key.ToString(), Count = g.Count() }).Where(s => s.Count > 1).Select(p => p.CentreCode);
            if (DuplicateCentre.Count() > 0)
            {
                ErrorMsg.Append("<b>Duplicate Centre_Code in your Uploaded File: </b></br>  ");
                foreach (string Centres in DuplicateCentre)
                {
                    ErrorMsg.Append(Centres + ", ");
                }
                InvalidCentre.Text = ErrorMsg.ToString();
                return true;
            }
            //----------------- -------------------------------------------------------
            //-------------------CHECK 4-----------------------------------------------
            OleDbCommand command1 = new OleDbCommand("select Centre_Code, Exam_Date  from [MS Access;Database=" + path + "].[Exam_Centre_Dates]", connection);
            OleDbDataAdapter dtadpt1 = new OleDbDataAdapter(command1);
            DataTable UploadDateSheet = new DataTable();
            dtadpt1.Fill(UploadDateSheet);
            if (UploadDateSheet.Rows.Count == 0)
            {
                ErrorMsg.Append("<b>Uploaded Exam_Centre_Dates file has Zero records. Please see the Uploaded data!</b>");
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
            foreach (DataColumn column in UploadDateSheet.Columns)
            {
                if (UploadDateSheet.Rows.OfType<DataRow>().Any(r => r.IsNull(column)))
                {
                    ErrorMsg.Append("<b>Uploaded Exam_Centre_Dates file cannot have null or empty</b></br>  ");
                    InvalidCity.Text = ErrorMsg.ToString();
                    return true;
                }
            }
            var CentreCode1 = from tbl in UploadDataSheet.AsEnumerable() let CentreCode = tbl.Field<string>("Centre_Code") select new { CentreCode };
            var CentreCode2 = from tbl in UploadDateSheet.AsEnumerable() let CentreCode = tbl.Field<string>("Centre_Code") select new { CentreCode };
            var difference1 = CentreCode1.Except(CentreCode2);

            if (difference1.Count() > 0)
            {
                ErrorMsg.Append("<b>Uploaded Exam_Centre_Dates file does not have all the Centre-Code available in Exam_Centre table</b></br>  ");
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
            var difference2 = CentreCode2.Except(CentreCode1);

            if (difference2.Count() > 0)
            {
                ErrorMsg.Append("<b>Uploaded Exam_Centre file does not have all the Centre-Code available in Exam_Centre_Dates table</b></br>  ");
                InvalidCity.Text = ErrorMsg.ToString();
                return true;
            }
            //-------------------------------------------------------------------------
            return false;
        }
        catch (Exception ex) { throw ex; }
        finally
        {
            con.Close();
            connection.Close();
            connection.Dispose();
        }
    }
    protected void PageIndexChanged(Int32 NewPageIndex)
    {
        try
        {
            gvMain.PageIndex = PagingBar1.CurrentPageIndex;
            if (ddlflCourse.SelectedValue != "0" && ddlflExam.SelectedValue != "0")
            {
                BindGridView();
            }

        }
        catch (Exception ex)
        {
            ShowAlert(ex.Message, true);
        }
    }
    protected void gvMain_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        try
        {
            if (e.Row.RowType == DataControlRowType.DataRow)
            {
                e.Row.Cells[0].Text = ((e.Row.RowIndex + 1)).ToString();
            }
        }
        catch (Exception ex) { ShowAlert(ex.Message); }
    }
    protected void FillFilterCourses()
    {
        try
        {
            using (EConnectContext context = new EConnectContext())
            {
                Int32 CourseTypeID = Convert.ToInt32(enmCourseType.CertificationExam);
                ListItem lst = new ListItem("--Select One--", "0");
                var CourseList = from p in context.Courses
                                 where p.CourseTypeID == CourseTypeID
                                 select new { ValueField = p.ID, TextField = p.Name };
                EConnect.Utils.Common.ControlUtility.BindListObject(ddlflCourse, CourseList, lst);
            };
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
    protected void ShowEditMode()
    {
        try
        {
            btnMode.ViewMode = ToggleView.Mode.List;
            mltvTab.ActiveViewIndex = 1;
            pnlFilter.Visible = false;
            lblHeading.Text = "Upload/View Exam Centre Available";
            //tbls2.Visible = false;
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }

}