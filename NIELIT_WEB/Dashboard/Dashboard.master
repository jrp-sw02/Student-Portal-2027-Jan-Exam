                                                <asp:ListItem>Delhi</asp:ListItem>
                                                </asp:DropDownList>--%>
                                          <%--  </li><br />--%>
                                        </ul>
                                    </td>
                                    <td colspan="2" valign="top"  align="right">
                                        <asp:ContentPlaceHolder ID="cpReportData" runat="server">
                                        </asp:ContentPlaceHolder>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <%--<tr>
                        <td colspan="3" valign="top" style="height: 5px;" align="left">
                        </td>
                    </tr>--%>
                    <tr>
                        <td colspan="3" align="center" class="footer" onclick="window.open('https://www.nielit.gov.in')">
                            Designed &amp; *Developed By NIELIT-HQ IT Team
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    </form>
</body>
</html>
