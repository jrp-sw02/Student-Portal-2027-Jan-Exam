<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Dashboard.master.cs" Inherits="Dashboard_Dashboard" %>

<%@ Register Src="../UserControl/NormalHeader.ascx" TagName="NormalHeader" TagPrefix="uc1" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 2012 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    <style type="text/css">
     .hyperlink_dash a:hover
     {
         font-size:large;
         color:Navy;
         text-decoration: underline;
      }
      .hyperlink_dash a
      {
          text-decoration: none;
          }
          .sub-heading{
  position:relative;
    color:#527C50 !important;
    font-family: Georgia;
    font-size:12px;
    font-weight:bold;
} 
  .sub- heading span
  {
      span{
    position:absolute;
    display:block;
    top:0;
    left:0;
    height:100%;
    width:100%;
    background:url('../images/glossy.png');
}
      }
          
    </style>
</head>
<body style="background-color: #ffffff;">
    <form id="form1" runat="server">
    <table width="100%" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
        <tr>
            <td align="center" valign="top">
                <table width="1000px" border="0" cellspacing="0" cellpadding="0" align="center">
                    <tr>
                        <td colspan="3" valign="top">
                            <uc1:NormalHeader ID="NormalHeader1" runat="server" />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" valign="top" style="height: 5px;" align="left">
                            &nbsp;
                        </td>
                    </tr>
                    <tr>
                        <td class="report_header" colspan="2" align="left" valign="middle">
                            <asp:ContentPlaceHolder ID="cpReportHeader" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                        <td class="report_header" style="width: 20%;" align="right" valign="middle">
                            <asp:ContentPlaceHolder ID="cpButtons" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                    <tr>
                        <td class="report_sub_header" colspan="2" valign="middle" align="left">
                            <asp:ContentPlaceHolder ID="cpSubHeader" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                        <td class="report_sub_header" style="width: 20%;" align="right" valign="top">
                            <asp:ContentPlaceHolder ID="cpReportDate" runat="server">
                            </asp:ContentPlaceHolder>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" valign="top" style="height: 10px;" align="left">
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <table width="1000px" border="0" cellspacing="0" cellpadding="0" align="center">
                                <tr>
                                    <td id="LeftSidebar" valign="top" align="left" style="background-color: Aqua; border: 1px solid black;
                                        border-color: Black;"   width="220px">
                                        <h2 style = "text-align:center; font-weight:bold; z-index:15;" ><u>Dashboard Subject</u></h2>
                                        <ul>
                                            <li class="hyperlink_dash"><a href ="RepositoryMaster.aspx">Online Services</a></li><br />
                                            <%--<li class="hyperlink_dash"><a href = "NDLMdashboard.aspx">NDLM Consolidated</a></li><br />
                                            <li class="hyperlink_dash"><a href = "NDLMDashboardStatewise.aspx">NDLM StateWise</a>--%>
