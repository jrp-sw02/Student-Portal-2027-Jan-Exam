<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MyInfo.master.cs" Inherits="MasterPages_MyInfo" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <script src="../Script/jquery-3.7.1.min.js" type="text/javascript"></script>
    <script src="../Script/jquery.dd.js" type="text/javascript"></script>
    <script src="../Script/login.js" type="text/javascript"></script>
    <script src="../Script/GlobalFunction.js" type="text/javascript"></script>
    <script src="../Script/shortcut.js" type="text/javascript"></script>
    <script src="../Script/browserDetect.js" type="text/javascript"></script>
    <script src="../Script/browserDetect-min.js" type="text/javascript"></script>
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 2012 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
        
     <%-- added by amit  --%>
    <script type="text/javascript">

        if (window.jQuery) {
            Object.defineProperty(jQuery.fn, "jquery", {
                get: function () { return ""; }
            });
        }

        </script>

    <%-- added by amit  --%>

</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager EnablePartialRendering="true" EnableViewState="true" ID="ScriptManager1" runat="server">
    </asp:ScriptManager>
    <div style="width: 100%;vertical-align: top;">
        <table align="center" cellpadding="0" cellspacing="0" width="1000px;" bgcolor="#ffffff">
            <tr>
                <td width="100%" valign="top" >
                    <table align="center" cellpadding="0" style="margin-top: 0; margin-bottom: 5px; margin-top:5px;"
                        cellspacing="0" width="1000px">
                        <tr>
                            <td width="5px" bgcolor="#FFFFFF">
                                &nbsp;
                            </td>
                            <td width="758px" <%-- class="table" --%> valign="top" >
                                <table align="center" cellpadding="0" cellspacing="0" width="100%" >
                                    <tr>
                                        <td align="left" class="heading2">
                                            <asp:ContentPlaceHolder ID="chpHeading" runat="server">
                                            </asp:ContentPlaceHolder>
                                        </td>
                                        <td valign="middle" align="right" class="heading2">
                                            <asp:ContentPlaceHolder ID="cphAddNew" runat="server">
                                            </asp:ContentPlaceHolder>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2"> 
                                            <div id="breadcrumb">
                                                <asp:ContentPlaceHolder ID="cphBreadScrum" runat="server">
                                                </asp:ContentPlaceHolder>
                                            </div> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td  colspan="2">
                                            <asp:ContentPlaceHolder ID="cphContents" runat="server">
                                            </asp:ContentPlaceHolder>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td  colspan="2">
                                            <asp:ContentPlaceHolder ID="cphNavigation" runat="server">
                                            </asp:ContentPlaceHolder>
                                        </td>
                                    </tr>
                                </table>
                            </td> 
                            <td width="7px" bgcolor="#FFFFFF">
                                &nbsp;
                            </td>
                            <td valign="top" bgcolor="#c7dded" style="min-height:445px; height:445px; max-height:100%; width:225px; ">
                                <asp:ContentPlaceHolder ID="cthRightPannel" runat="server">
                                </asp:ContentPlaceHolder>
                            </td>
                            <td width="5" bgcolor="#FFFFFF">
                                    &nbsp;
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
    </form>
</body>
</html>
