    </customErrors>
    <httpRuntime enableVersionHeader="false" executionTimeout="900000" maxRequestLength="35600" useFullyQualifiedRedirectUrl="false" minFreeThreads="8" minLocalRequestFreeThreads="4" appRequestQueueLimit="100"/>
    <pages theme="Blue" enableViewStateMac="true" viewStateEncryptionMode="Always" validateRequest="true" controlRenderingCompatibilityVersion="4.0">
