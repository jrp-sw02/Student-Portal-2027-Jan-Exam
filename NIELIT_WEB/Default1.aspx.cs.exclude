using System;
using System.Configuration;

public partial class _Default1 : System.Web.UI.Page 
{
    protected void Page_Load(object sender, EventArgs e)
    {

    }

    protected void EncryptData(object sender, EventArgs e)
    {
        try
        {
            byte[] array = System.Text.Encoding.UTF8.GetBytes(ConfigurationManager.AppSettings["KeyValue"]);
            this.lblProcessedContent.Text = "";
            this.lblProcessedContent.Text = EncryptDecryptPG.EncryptDecrypt.Encrypt(this.txtContent.Value.Trim(), array);
        }
        catch (System.Exception ex)
        {
            this.lblProcessedContent.Text = ex.Message;
        }
    }

    protected void DecryptData(object sender, EventArgs e)
    {
        try
        {
            byte[] array = System.Text.Encoding.UTF8.GetBytes(ConfigurationManager.AppSettings["KeyValue"]);
            this.lblProcessedContent.Text = "";
            this.lblProcessedContent.Text = EncryptDecryptPG.EncryptDecrypt.Decrypt(this.txtContent.Value.Trim(), array);
        }
        catch (System.Exception ex)
        {
            this.lblProcessedContent.Text = ex.Message;
        }
    }
}
