<%@ Page Language="C#" AutoEventWireup="true"  CodeFile="Default1.aspx.cs" Inherits="_Default1" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Oxigen Payment Gateway: Encrypt/Decrypt</title>
</head>
<body>
    <form id="form1" runat="server">
    <div>
        Text Content <input type="text" id="txtContent" runat="server" /> <asp:Button ID="btnEncrypt" Text="Encrypt" runat="server" OnClick="EncryptData" /> <asp:Button ID="btnDecrypt" Text="Decrypt" runat="server" OnClick="DecryptData" /><br />
        <hr />
        <asp:Label ID="lblProcessedContent" runat="server"></asp:Label>
    </div>
    </form>
</body>
</html>
