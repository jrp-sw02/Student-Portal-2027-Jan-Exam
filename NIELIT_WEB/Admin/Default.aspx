              <td>
                   <asp:CheckBox runat="server" id ="chk_declaration" text="Declaration" ></asp:CheckBox> </td>
                <td class="auto-style3" >
                   </td>
          </tr>
          <tr>
              <td>

                  &nbsp;</td>
              <td>
                   &nbsp;</td>
                <td class="auto-style3" >
