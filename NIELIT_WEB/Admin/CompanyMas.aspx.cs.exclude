    protected void SaveRecord(object sender, EventArgs e)
    {
        try
        {
            BreadCrumb1.Render();
            using (TransactionScope scope = new TransactionScope())
            {
                using (NIELITMISContext context = new NIELITMISContext())
                {
                    companyMaster objCompany;
                    companyMasterHistory objCompanyHistory;

                    if (String.IsNullOrEmpty(Request.QueryString["Key"]))
                    {

                        objCompany = new companyMaster();

                        objCompany.company_Name = txtCompanyName.Text;
                        objCompany.contactPersonName = txtPersonName.Text;
                        objCompany.contactPersonMobile = Convert.ToInt64(txtMob.Text);
                        objCompany.PersonEmail = txtEmailID.Text;
                        objCompany.comapny_Address = txtCmpAdd1.Text;
                        objCompany.comapny_Address2 = txtCmpAdd2.Text;
                        objCompany.comapny_Address3 = txtCmpAdd3.Text;
                        objCompany.CompnyCityName = txtCmyCityName.Text;
                        objCompany.CompnyCountry_ID = 1;
                        objCompany.compnyState_ID = Convert.ToInt32(ddlCmpState.SelectedValue);
                        objCompany.compnyDistrict_ID = Convert.ToInt32(ddlCmpDistrict.SelectedValue);
                        objCompany.CompnyPinCode = Convert.ToInt32(txtCmpPinCode.Text);

						objCompany.enter_By = Convert.ToInt32(Session["UserID"]);
                        objCompany.enter_Date = DateTime.Now;
                        //objOccupation.CourseID = Convert.ToInt32(ddlcourse.SelectedValue);
                        context.companyMasters.Add(objCompany);
                        context.SaveChanges();
                        strMessage = "New record saved";

                    }
                    else
                    {
                        Int32 keyID = Convert.ToInt32(Request.QueryString["Key"]);

                        objCompany = context.companyMasters.Find(Convert.ToInt32(Request.QueryString["key"]));
                        
                        

                        //Insert Company History
                        objCompanyHistory = new companyMasterHistory();
                        objCompanyHistory.CompanyID = Convert.ToInt64(keyID);
                        objCompanyHistory.company_Name = objCompany.company_Name;
                        objCompanyHistory.contactPersonName = objCompany.contactPersonName ;
                        objCompanyHistory.PersonEmail = objCompany.PersonEmail;
                        objCompanyHistory.contactPersonMobile = Convert.ToInt64(objCompany.contactPersonMobile);
                        objCompanyHistory.comapny_Address = objCompany.comapny_Address;
                        objCompanyHistory.comapny_Address2 = objCompany.comapny_Address2;
                        objCompanyHistory.comapny_Address3 = objCompany.comapny_Address3;
                        objCompanyHistory.CompnyCityName = objCompany.CompnyCityName;
                        objCompanyHistory.CompnyCountry_ID = 1;
                        objCompanyHistory.compnyState_ID = Convert.ToInt32(objCompany.compnyState_ID);
                        objCompanyHistory.compnyDistrict_ID = Convert.ToInt32(objCompany.compnyDistrict_ID);
                        objCompanyHistory.CompnyPinCode = Convert.ToInt32(objCompany.CompnyPinCode);
                        
                        //objCompanyHistory.CompanyID = Convert.ToInt64(keyID);
                        //objCompanyHistory.company_Name = txtCompanyName.Text;
                        //objCompanyHistory.contactPersonName = txtPersonName.Text;
                        //objCompanyHistory.PersonEmail = txtEmailID.Text;
                        //objCompanyHistory.contactPersonMobile = Convert.ToInt64(txtMob.Text);
                        //objCompanyHistory.comapny_Address = txtCmpAdd1.Text;
                        //objCompanyHistory.comapny_Address2 = txtCmpAdd2.Text;
                        //objCompanyHistory.comapny_Address3 = txtCmpAdd3.Text;
                        //objCompanyHistory.CompnyCityName = txtCmyCityName.Text;
                        //objCompanyHistory.CompnyCountry_ID = 1;
                        //objCompanyHistory.compnyState_ID = Convert.ToInt32(ddlCmpState.SelectedValue);
                        //objCompanyHistory.compnyDistrict_ID = Convert.ToInt32(ddlCmpDistrict.SelectedValue);
                        //objCompanyHistory.CompnyPinCode = Convert.ToInt32(txtCmpPinCode.Text);
                        //objCompanyHistory.CompnyPinCode = Convert.ToInt32(txtCmpPinCode.Text);
                        objCompanyHistory.enter_By = Convert.ToInt32(Session["UserID"]);
                        objCompanyHistory.enter_Date = DateTime.Now;
                        context.companyMasterHistorys.Add(objCompanyHistory);
                        context.SaveChanges();
                        //EndOfCompanyHistory

                        objCompany.company_Name = txtCompanyName.Text;
                        objCompany.contactPersonName = txtPersonName.Text;
                        objCompany.PersonEmail = txtEmailID.Text;
                        objCompany.contactPersonMobile = Convert.ToInt64(txtMob.Text);
                        objCompany.comapny_Address = txtCmpAdd1.Text;
                        objCompany.comapny_Address2 = txtCmpAdd2.Text;
                        objCompany.comapny_Address3 = txtCmpAdd3.Text;
                        objCompany.CompnyCityName = txtCmyCityName.Text;
                        objCompany.CompnyCountry_ID = 1;
                        objCompany.compnyState_ID = Convert.ToInt32(ddlCmpState.SelectedValue);
                        objCompany.compnyDistrict_ID = Convert.ToInt32(ddlCmpDistrict.SelectedValue);
                        objCompany.CompnyPinCode = Convert.ToInt32(txtCmpPinCode.Text);
                        objCompany.CompnyPinCode = Convert.ToInt32(txtCmpPinCode.Text);

                        context.SaveChanges();
                        strMessage = "Record updated";

                    }
                   // Response.Redirect("CompanyMas.aspx?msg=" + strMessage);
                };
                scope.Complete();
            };
            Response.Redirect("CompanyMas.aspx?msg=" + strMessage);
           
        }
        catch (Exception ex)
        {
            
            ShowAlert(ex.Message, true);
        }
    }

