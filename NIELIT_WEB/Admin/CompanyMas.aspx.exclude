<%--<%@ Page Language="C#" AutoEventWireup="true" CodeFile="CompanyMas.aspx.cs" Inherits="Admin_CompanyMas" %>--%>

<%@ Page Title="" Language="C#" MasterPageFile="~/MasterPages/main.master" AutoEventWireup="true"
    CodeFile="CompanyMas.aspx.cs" Inherits="Admin_CompanyMas"  %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>
<%@ Register Src="../UserControl/SearchBar.ascx" TagName="SearchBar" TagPrefix="uc1" %>
<%@ Register Src="../UserControl/ToggleView.ascx" TagName="ToggleView" TagPrefix="uc2" %>
<%@ Register Src="../UserControl/PagingBar.ascx" TagName="PagingBar" TagPrefix="uc3" %>
<%@ Register Src="../UserControl/BreadCrumb.ascx" TagName="BreadCrumb" TagPrefix="uc4" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="chpHeading" runat="Server">
    <asp:Label ID="lblHeading" runat="server" Text="Company Master"></asp:Label>
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="cphAddNew" runat="Server">
    <uc2:ToggleView ID="btnMode" OnBtnMode_Click="ToggleViewMode_Changed" runat="server" />
    <asp:Panel runat="server" ID="pnlFilter" Visible="false">
        <div id="filterContainer">
            <a href="#" id="filterButton"><span></span><em></em></a>
            <div style="clear: both">
            </div>
            <div id="filterBox" align="left">
                <div id="filterPannel">
                    <asp:UpdatePanel EnableViewState="true" RenderMode="Inline" ID="filterPnal_upnlFilter"
                        UpdateMode="Conditional" runat="server">
                        <ContentTemplate>
                            <table cellpadding="0" id="body1" cellspacing="0" width="100%">
                                <tr>
                                    <td>
                                        <asp:Label ID="lblFiler" Width="60%" runat="server" Font-Bold="true" Font-Size="12pt"
                                            Text="Filter Panel"></asp:Label>
                                        <asp:Button runat="server" ID="btnReset" ToolTip="Reset Filter" ClientIDMode="Static"
                                            Text="" OnClick="ResetFilterPanel" />
                                        <asp:Button runat="server" ToolTip="Apply Filter" ID="btnFilter" ClientIDMode="Static"
                                            Text="" OnClick="AllyFilter" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <asp:Label ID="Label1" Width="100%" runat="server" Text="Company Master"></asp:Label>
                                        <asp:DropDownList ID="ddlOccupation" Width="100%" runat="server" AutoPostBack="True">
                                            <asp:ListItem Value="0" Text="--All--"></asp:ListItem>
                                        </asp:DropDownList>
                                    </td>
                                </tr>
                            </table>
                        </ContentTemplate>
                    </asp:UpdatePanel>
                </div>
                <script language="javascript" type="text/javascript">
                    var box = $('#filterBox');
                    shortcut.add("Ctrl+Shift+F", function () {
                        box.show();
                    });
                    shortcut.add("Esc", function () {
                        box.hide();
                    });
                </script>
            </div>
        </div>
    </asp:Panel>
    <uc1:SearchBar ID="ucSearchBar" OnLnkBtnResetSearch="SearchBar_Reset" SearchTextToolTip="Search by Company Name,Person Name"
        OnLnkBtnGO="SearchBar_ApplySearch" runat="server" AutoCompleteFirstRowSelected="True"
        AutoCompleteMinimumPrefixLength="1" AutoCompleteServiceMethod="GetSearchText"
        AutoCompleteCompletionSetCount="10" />
</asp:Content>
<asp:Content ID="Content4" ContentPlaceHolderID="cphBreadScrum" runat="Server">
    <uc4:BreadCrumb ID="BreadCrumb1" runat="server" />
</asp:Content>
<asp:Content ID="Content5" ContentPlaceHolderID="cphContents" runat="Server">
    <script language="javascript" type="text/javascript">
        function ValidateFormFields() {

            if (!isBlank("<%=txtCompanyName.ClientID %>", "Company Name"))
                return false;
            if (!isBlank("<%=txtPersonName.ClientID %>", "Contact Person Name"))
                return false;
            if (!isBlank("<%=txtMob.ClientID %>", "Mobile Number"))
                return false;
            if (!chekMobNo("<%=txtMob.ClientID %>", "Mobile Number"))
                return false;
            if(!isNumber("<%=txtMob.ClientID %>","Mobile Number"))
                return false;
            if (!isBlank("<%=txtCmpAdd1.ClientID %>", "Company AddressLine 1"))
                return false;
            if (!isSelected("<%=ddlCmpState.ClientID %>", "State"))
                return false;
            if (!isSelected("<%=ddlCmpDistrict.ClientID %>", "District"))
                return false;
            if (!isBlank("<%=txtCmpPinCode.ClientID %>", "Pin Code"))
                return false;
            if (!isNumber("<%=txtCmpPinCode.ClientID %>"))
                return false;

            if (!IsValidMinMaxLenght("<%=txtCmpPinCode.ClientID %>", 6, 6, "Invalid Pin Code"))
                return false;
            if (!isBlank("<%=txtEmailID.ClientID %>", "Email Id"))
                return false;
            if (!isValidEmail("<%=txtEmailID.ClientID %>", "Invalid E-Mail ID"))
                return false;

        }


        var dtgp = "<%= gvMain.ClientID %>"
        function CheckAll(Sender, CheckBoxName) {
            CheckUncheckAll(dtgp, Sender, CheckBoxName)
        }
        function PerformAction(obj, tableid) {
            document.getElementById("<%=hfActionID.ClientID %>").value = obj.id.split("_")[1];
            ShowHideMenu(obj, tableid);
        }
    </script>
    <asp:MultiView ID="mltvTab" runat="server" ActiveViewIndex="0">
        <asp:View ID="List" runat="server">
            <div id="divGrid" runat="server">
                <asp:UpdatePanel EnableViewState="true" ID="uPnlGrid" UpdateMode="Conditional" runat="server">
                    <ContentTemplate>
                        <table id="popup" clientidmode="Static" runat="server" cellpadding="2" cellspacing="0"
                            class="ActionPopup" style="width: 100px; height: 40px;">
                            <tr>
                                <td align="left">
                                    <asp:LinkButton ID="lbDelteteOne" OnClientClick="return ConfirmAction('Are you sure you want to delete this record!');"
                                        runat="server" Text="Delete" ToolTip="click to delete this record" SkinID="lnkbtnAction"
                                        OnClick="PerformPopupAction"></asp:LinkButton>
                                    <%--<asp:LinkButton ID="lbdisable" OnClientClick="return ConfirmAction('Are you sure you want to change the status of the selected occupation!');"
                                        runat="server" Text="Change Status" ToolTip="click to change status of this record"
                                        SkinID="lnkbtnAction" OnClick="lbdisable_Click"></asp:LinkButton>--%>
                                </td>
                            </tr>
                        </table>
                        <asp:GridView ID="gvMain" runat="server" DataKeyNames="ID" OnSorting="gvMain_Sorting"
                            OnRowDataBound="gvMain_RowDataBound" AutoGenerateColumns="False" Width="100%">
                            <Columns>
                                <asp:BoundField HeaderStyle-Width="4%" HeaderText="#">
                                    <HeaderStyle Width="5%" />
                                    <ItemStyle HorizontalAlign="Right" />
                                </asp:BoundField>
                                <asp:HyperLinkField HeaderStyle-Width="45%" DataNavigateUrlFields="ID" DataNavigateUrlFormatString="?Key={0}"
                                    DataTextField="Name" HeaderText="Company Name" SortExpression="Name" Target="_self">
                                    <HeaderStyle Width="45%" />
                                </asp:HyperLinkField>
                                <asp:HyperLinkField HeaderStyle-Width="10%" DataNavigateUrlFields="ID" DataNavigateUrlFormatString="?Key={0}"
                                    DataTextField="PersonName" HeaderText="Contact Person Name" SortExpression="Code" Target="_self">
                                    <HeaderStyle Width="10%" />
                                    <ItemStyle HorizontalAlign="Left" />
                                </asp:HyperLinkField>
                                <asp:HyperLinkField HeaderStyle-Width="10%" DataNavigateUrlFields="ID" DataNavigateUrlFormatString="?Key={0}"
                                    DataTextField="PersonMobile" HeaderText="Person Mobile" SortExpression="Active" Target="_self">
                                    <HeaderStyle Width="10%" />
                                    <ItemStyle HorizontalAlign="Left" />
                                </asp:HyperLinkField>
                                <asp:HyperLinkField HeaderStyle-Width="20%" DataNavigateUrlFields="ID" DataNavigateUrlFormatString="?Key={0}"
                                    DataTextField="Location" HeaderText="Location" SortExpression="Location" Target="_self">
                                    <HeaderStyle Width="20%" />
                                </asp:HyperLinkField>
                                <asp:TemplateField HeaderStyle-Width="3%" HeaderText="" HeaderImageUrl="~/images/fleche_down_sel.gif">
                                    <ItemTemplate>
                                        <asp:Image ClientIDMode="Static" ToolTip="Action" onclick="PerformAction(this,'popup')"
                                            runat="server" ID="imgAction" ImageUrl="~/images/fleche_down_sel.gif" ImageAlign="Middle"
                                            Style="cursor: pointer; border: 1px solid transparent;" />
                                    </ItemTemplate>
                                    <HeaderStyle Width="3%" />
                                    <ItemStyle HorizontalAlign="Center" />
                                </asp:TemplateField>
                                <asp:TemplateField HeaderStyle-Width="3%" HeaderText="" Visible="false">
                                    <HeaderTemplate>
                                        <asp:CheckBox runat="server" ID="chk" SkinID="CheckAllInGridView" />
                                    </HeaderTemplate>
                                    <ItemTemplate>
                                        <asp:CheckBox runat="server" ID="CheckBox1" SkinID="CheckAllInGridView" />
                                    </ItemTemplate>
                                    <HeaderStyle Width="3%" />
                                    <ItemStyle HorizontalAlign="Center" />
                                </asp:TemplateField>
                            </Columns>
                            <PagerSettings Visible="False" />
                        </asp:GridView>
                        <asp:HiddenField ID="hfActionID" runat="server" Value="" />
                        <asp:HiddenField ID="hfcode" runat="server" />
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
            <div id="divNavigation" runat="server">
                <asp:UpdatePanel RenderMode="Inline" ID="uPnlNavigation" UpdateMode="Conditional"
                    runat="server">
                    <ContentTemplate>
                        <uc3:PagingBar ID="PagingBar1" runat="server" OnPageIndexChanged="PageIndexChanged" />
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
        </asp:View>
        <asp:View ID="New" runat="server">
            <%--<div style="background-color:#A8A8A8; width:98%;">--%>
            <table class="sample2" cellpadding="2" cellspacing="0" width="100%">
                <tr>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCompanyName" runat="server" Text="Company Name <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblPersonName" runat="server" Text="Contact Person Name <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblMob" runat="server" Text="Mobile Number <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                </tr>
                <tr class="even">
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCompanyName" runat="server" SkinID="txt248" MaxLength="100" onkeypress="return isNumberKey(event);"></asp:TextBox>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtPersonName" runat="server" SkinID="txt248" TabIndex="26" MaxLength="100"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"></asp:TextBox>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtMob" runat="server"   SkinID="txt248"  TabIndex="26" MaxLength="10"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"></asp:TextBox>
                    </td>
                </tr>
                
                <tr>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpAdd1" runat="server" Text="Address Line1 <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpAdd2" runat="server" Text="Address Line2 <b class='mandatory'></b>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpAdd3" runat="server" Text="Address Line3"></asp:Label>
                    </td>
                </tr>
                <tr class="even">
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCmpAdd1" runat="server" SkinID="txt248" TabIndex="27" MaxLength="100"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"  ></asp:TextBox>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCmpAdd2" runat="server" SkinID="txt248" TabIndex="27" MaxLength="100"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"  ></asp:TextBox>
                               </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCmpAdd3" runat="server" SkinID="txt248" TabIndex="28" MaxLength="100"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"  ></asp:TextBox>
                                
                    </td>
                </tr>
                

                <tr>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpState" runat="server" Text="State  <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpDistrict" runat="server" Text="District   <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmyCityName" runat="server" Text="City Name  <b class='mandatory'></b>">
                                </asp:Label>
                    </td>
                </tr>
                <tr class="even">
                    <td style="width: 33%;" valign="top">
                        <asp:DropDownList ID="ddlCmpState" runat="server" SkinID="ddl250" AutoPostBack="True" OnSelectedIndexChanged="ddlCmpState_SelectedIndexChanged"
                                    TabIndex="30"   >
                                </asp:DropDownList> 
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:UpdatePanel ID="UpdatePanel2" runat="server">
                                    <ContentTemplate>
                                        <asp:DropDownList ID="ddlCmpDistrict"  runat="server" TabIndex="31" SkinID="ddl250"  >
                                            <asp:ListItem Value="0">--Select One--</asp:ListItem>
                                        </asp:DropDownList>
                                    </ContentTemplate>
                                    <Triggers>
                                        <asp:AsyncPostBackTrigger ControlID="ddlCmpState" EventName="SelectedIndexChanged" />
                                    </Triggers>
                                </asp:UpdatePanel>
                         </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCmyCityName" runat="server" SkinID="txt248" TabIndex="29" MaxLength="50"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"  ></asp:TextBox>
                                      
                    </td>
                </tr>

                <tr>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblCmpPinCode" runat="server" SkinID="txt248" Text="Pin Code    <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:Label ID="lblEmail" runat="server" SkinID="txt248" Text="Contact Person Email ID   <font color='RED'>*</font>">
                                </asp:Label>
                    </td>
                    <td style="width: 33%;" valign="top">
                       
                    </td>
                </tr>
                <tr class="even">
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtCmpPinCode" runat="server" oncopy="return false" oncut="return false"
                                    onkeypress="checkNumber(this,6,0,event);" onpaste="return false" TabIndex="32" 
                            SkinID="txt248"
                                    Width="93px" MaxLength="6"  ></asp:TextBox>
                    </td>
                    <td style="width: 33%;" valign="top">
                        <asp:TextBox ID="txtEmailID" runat="server" SkinID="txt248" TabIndex="26" MaxLength="100"
                                    onpaste="return false;" oncopy="return false;" oncut="return false;"></asp:TextBox>
                         </td>
                    <td style="width: 33%;" valign="top">
                                   
                    </td>
                </tr>

            </table>
            <div style="text-align: right; margin-top: 10px">
                <asp:Button ID="btnSave" OnClientClick="return ValidateFormFields();" runat="server"
                    Text="Save" OnClick="SaveRecord" />
                <asp:Button ID="btnCancel" runat="server" Text="Cancel" OnClick="btnCancel_Click" />
            </div>
        </asp:View>
    </asp:MultiView>
</asp:Content>
<asp:Content ID="Content6" ContentPlaceHolderID="cphNavigation" runat="Server">
</asp:Content>
<asp:Content ID="Content7" ContentPlaceHolderID="cthRightPannel" runat="Server">
</asp:Content>
