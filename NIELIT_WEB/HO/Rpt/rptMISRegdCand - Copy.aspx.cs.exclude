    protected bool isValidForm()
    {
        if (ddlProjectBased.SelectedValue == "0")
        {
            ShowAlert("Kindly choose a Project");
            return false;
        }

        if (string.IsNullOrWhiteSpace(rtxtDob1.Text) || string.IsNullOrWhiteSpace(rtxtDob2.Text))
        {
            ShowAlert("Please enter both dates.");
            return false;
        }

        return true;
    }

    protected void btnSubmit_Click(object sender, EventArgs e)
    {

        if (!isValidForm())
            return;


        try
        {
            using (var conn = new SqlConnection(ConfigurationManager.ConnectionStrings["EConnectContext"].ToString()))
            {
                conn.Open();


                using (var cmd = new SqlCommand("temp_sp_InsertProjectFilterLog", conn))
                {
                    cmd.CommandType = CommandType.StoredProcedure;

                    cmd.Parameters.AddWithValue("@ProjectBased", ddlProjectBased.SelectedValue);
                    cmd.Parameters.AddWithValue("@DateFrom", DateTime.Parse(rtxtDob1.Text));
                    cmd.Parameters.AddWithValue("@CandidateType", rCenter.SelectedValue);
                    cmd.Parameters.AddWithValue("@DateTo", DateTime.Parse(rtxtDob2.Text));


                    cmd.ExecuteNonQuery();
                }
                //lblError.Text = "Data submitted successfully!";
                //lblError.Visible = true;

                // Clear the form
                ddlProjectBased.SelectedIndex = 0;
                rCenter.ClearSelection();
                rtxtDob1.Text = "";
                rtxtDob2.Text = "";

                ShowAlert("Data Submitted Succesfully");


            }
        }
        catch (Exception ex)
        {
            ShowAlert("Data Not uploaded");
        }
        
    }

}